---
// FsAiWizard.astro — AI match wizard (homepage hero centerpiece · 大王 2026-07-07)
// Data lazy-loaded from /wizard_cities.json (219 cities · native currency · data-driven bands).
// Lead posts to https://chat.unistay.cn/lead (same store + advisor email).
---
<div class="fsw" id="fsw" data-fsw-init="0">
  <div class="fsw-tag"><span class="dot" aria-hidden="true"></span>AI housing match · 774k reviews</div>
  <div class="fsw-bar"><i id="fswBar"></i></div>
  <div id="fswView" class="fsw-view"><div class="fsw-load">Loading matches…</div></div>
  <div class="fsw-foot" id="fswFoot"><a href="#" id="fswChat">Rather chat with us? →</a></div>
</div>

<style is:global>
.fsw{background:#fff;border-radius:22px;box-shadow:0 30px 70px rgba(20,18,42,.28);overflow:hidden;max-width:460px;width:100%;text-align:left;color:#14122A;font-family:"Inter",sans-serif}
.fsw-tag{display:flex;align-items:center;gap:8px;font-size:12px;font-weight:600;color:#4B3FE4;padding:16px 22px 0}
.fsw-tag .dot{width:7px;height:7px;border-radius:50%;background:#CDEB5A;box-shadow:0 0 0 3px #EEECFF}
.fsw-bar{height:4px;background:#EEECFF;margin-top:14px}
.fsw-bar i{display:block;height:100%;width:20%;background:#4B3FE4;transition:width .4s cubic-bezier(.2,.7,.3,1)}
.fsw-view{min-height:230px}
.fsw-load{padding:60px;text-align:center;color:#6B6880;font-size:14px}
.fsw-body{padding:22px}
.fsw-sh{display:flex;align-items:center;justify-content:space-between}
.fsw-sn{font-family:"Space Grotesk",sans-serif;font-weight:600;font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:#4B3FE4}
.fsw-back{background:none;border:0;color:#6B6880;font-size:13px;cursor:pointer;font-family:inherit}
.fsw-back:hover{color:#14122A}
.fsw-q{font-family:"Space Grotesk",sans-serif;font-weight:600;font-size:21px;letter-spacing:-.02em;margin:8px 0 16px;line-height:1.15}
.fsw-srch{display:flex;align-items:center;gap:10px;border:1.5px solid #E2DFF0;border-radius:13px;padding:0 14px;height:50px;margin-bottom:12px}
.fsw-srch:focus-within{border-color:#4B3FE4;box-shadow:0 0 0 4px #EEECFF}
.fsw-srch svg{width:18px;height:18px;color:#6B6880;flex:none}
.fsw-srch input{border:0;outline:0;font:inherit;font-size:15px;width:100%;background:none}
.fsw-chips{display:flex;flex-wrap:wrap;gap:7px}
.fsw-chip{border:1.5px solid #E2DFF0;background:#fff;border-radius:999px;padding:7px 13px;font-size:13px;font-weight:600;font-family:"Space Grotesk",sans-serif;cursor:pointer;color:#14122A}
.fsw-chip:hover{border-color:#4B3FE4;color:#4B3FE4}
.fsw-opts{display:grid;gap:9px}
.fsw-opts.two{grid-template-columns:1fr 1fr}
.fsw-opt{border:1.5px solid #E2DFF0;border-radius:13px;padding:13px 15px;cursor:pointer;background:#fff;text-align:left;font-family:inherit;display:flex;align-items:center;gap:11px;color:#14122A}
.fsw-opt:hover{border-color:#4B3FE4;background:#FCFCFF}
.fsw-opt .t{font-family:"Space Grotesk",sans-serif;font-weight:600;font-size:14.5px}
.fsw-opt .s{font-size:12px;color:#6B6880}
.fsw-opt.ctr{justify-content:center;text-align:center;flex-direction:column;gap:2px;padding:13px 6px}
.fsw-ta{width:100%;min-height:88px;border:1.5px solid #E2DFF0;border-radius:13px;padding:13px;font:inherit;font-size:14.5px;outline:0;resize:vertical}
.fsw-ta:focus{border-color:#4B3FE4;box-shadow:0 0 0 4px #EEECFF}
.fsw-hints{display:flex;flex-wrap:wrap;gap:6px;margin-top:11px}
.fsw-hint{background:#EEECFF;color:#4B3FE4;border:0;border-radius:999px;padding:6px 11px;font-size:12px;font-weight:600;font-family:"Space Grotesk",sans-serif;cursor:pointer}
.fsw-cta{width:100%;height:50px;border:0;border-radius:13px;font-family:"Space Grotesk",sans-serif;font-weight:700;font-size:15.5px;cursor:pointer;background:#4B3FE4;color:#fff;box-shadow:0 8px 22px rgba(75,63,228,.3);margin-top:14px}
.fsw-cta:hover{background:#3A2FC4}
.fsw-think{padding:48px 22px;text-align:center}
.fsw-orb{width:60px;height:60px;margin:0 auto 18px;border-radius:50%;background:#EEECFF;position:relative}
.fsw-orb::after{content:"";position:absolute;inset:-6px;border-radius:50%;border:3px solid #4B3FE4;border-right-color:transparent;animation:fswspin .8s linear infinite}
@keyframes fswspin{to{transform:rotate(360deg)}}
.fsw-think .t{font-family:"Space Grotesk",sans-serif;font-weight:600;font-size:17px}
.fsw-think .s{color:#6B6880;font-size:13.5px;margin-top:6px}
.fsw-rh{padding:20px 20px 4px}
.fsw-rh .lab{font-family:"Space Grotesk",sans-serif;font-weight:600;font-size:11.5px;letter-spacing:.1em;text-transform:uppercase;color:#12B76A}
.fsw-rh h3{font-family:"Space Grotesk",sans-serif;font-weight:600;font-size:18px;margin-top:6px;color:#14122A;letter-spacing:-.02em}
.fsw-kb{font-size:11.5px;color:#4B3FE4;background:#EEECFF;display:inline-block;padding:4px 10px;border-radius:8px;margin-top:9px;font-weight:600}
.fsw-list{padding:12px 16px}
.fsw-pc{display:flex;gap:12px;padding:10px;border-radius:14px;border:1px solid #ECEAF4;margin-bottom:9px;text-decoration:none;color:inherit;transition:.15s}
.fsw-pc:hover{border-color:#E2DFF0;box-shadow:0 8px 24px rgba(20,18,42,.08)}
.fsw-pc .im{width:84px;height:84px;border-radius:11px;background:#EEECFF center/cover;flex:none;position:relative}
.fsw-pc .vb{position:absolute;top:5px;left:5px;background:rgba(255,255,255,.92);color:#12B76A;font-size:9px;font-weight:700;padding:2px 6px;border-radius:999px}
.fsw-pc h4{font-family:"Space Grotesk",sans-serif;font-weight:600;font-size:15px;margin-bottom:3px;line-height:1.2}
.fsw-pc .rt{font-size:12px;color:#6B6880;margin-bottom:5px}.fsw-pc .rt b{color:#FF6455}
.fsw-pc .why{font-size:11.5px;color:#4B3FE4;background:#EEECFF;display:inline-block;padding:2px 8px;border-radius:7px;font-weight:600}
.fsw-pc .pr{margin-left:auto;text-align:right;flex:none}
.fsw-pc .pr b{font-family:"Space Grotesk",sans-serif;font-weight:700;font-size:15.5px}
.fsw-pc .pr s{display:block;font-size:10.5px;color:#6B6880;text-decoration:none}
.fsw-lead{background:#14122A;color:#fff;padding:20px 22px}
.fsw-lead h4{color:#fff;font-family:"Space Grotesk",sans-serif;font-size:16px;font-weight:600;margin-bottom:3px}
.fsw-lead p{color:rgba(255,255,255,.7);font-size:12.5px;margin-bottom:12px}
.fsw-lf{display:flex;gap:8px;margin-bottom:8px}
.fsw-lf input{flex:1;height:44px;border-radius:11px;border:0;padding:0 13px;font:inherit;font-size:14px;outline:0}
.fsw-lead .fsw-cta{margin-top:2px}
.fsw-err{color:#FFB4A8;font-size:12px;margin-top:6px;display:none}
.fsw-trust{text-align:center;font-size:11px;color:rgba(255,255,255,.5);margin-top:10px}
.fsw-done{padding:46px 24px;text-align:center}
.fsw-done .ck{width:60px;height:60px;border-radius:50%;background:#E7F7EF;display:grid;place-items:center;margin:0 auto 16px;color:#12B76A;font-size:28px}
.fsw-done h3{font-family:"Space Grotesk",sans-serif;font-size:20px;font-weight:600}
.fsw-done p{color:#6B6880;margin-top:8px;font-size:14px}
.fsw-foot{padding:13px 22px;text-align:center;border-top:1px solid #ECEAF4}
.fsw-foot a{color:#4B3FE4;font-size:13px;font-weight:600;text-decoration:none}
</style>

<script is:inline src="/_i/d423b01d.js"></script>
