---
import { ClientRouter } from "astro:transitions";
import {
  PUBLIC_GOOGLE_SITE_VERIFICATION,
  PUBLIC_BING_VERIFICATION,
  PUBLIC_BAIDU_VERIFICATION,
  PUBLIC_SOGOU_VERIFICATION,
  PUBLIC_360_VERIFICATION,
  PUBLIC_SHENMA_VERIFICATION,
  PUBLIC_TOUTIAO_VERIFICATION,
} from "astro:env/client";
import { SITE } from "@/config";
import "@/styles/global.css";

type Props = {
  title?: string;
  author?: string;
  profile?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  scrollSmooth?: boolean;
  tags?: string[];
};

const {
  title = SITE.title,
  author = SITE.author,
  profile = SITE.profile,
  description = SITE.desc,
  ogImage = SITE.ogImage ? `/${SITE.ogImage}` : "/og.png",
  canonicalURL = new URL(Astro.url.pathname, Astro.url),
  pubDatetime,
  modDatetime,
  scrollSmooth = false,
  tags,
} = Astro.props;

// 百度等中文搜索引擎仍会读取 meta keywords；Google 不再使用但也不会扣分。
// 文章页：用文章自身 tags；非文章页：用站点全局主题词。
const metaKeywords =
  tags && tags.length > 0
    ? tags.join(", ")
    : "出国留学, 英国留学, 美国留学, 澳洲留学, 加拿大留学, 新西兰留学, 日本留学, 韩国留学, 香港留学, 新加坡留学, 马来西亚留学, 欧洲留学, 留学申请, 学生签证, 雅思托福, 留学奖学金, 毕业工签";

const socialImageURL = new URL(ogImage, Astro.url);

// 文章页（有 pubDatetime）会同时输出 BlogPosting 和 QAPage 两套结构化数据：
// - BlogPosting 让 Google / 社交分享认出这是一篇文章
// - QAPage 明确告诉 AI 爬虫（ChatGPT / Perplexity / Gemini 等）
//   "本页是一问一答"，标题 = 问题，正文 = 答案。
const isPost = Boolean(pubDatetime);

const blogPostingSchema = isPost
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: `${title}`,
      image: `${socialImageURL}`,
      datePublished: pubDatetime!.toISOString(),
      ...(modDatetime && { dateModified: modDatetime.toISOString() }),
      author: [
        {
          "@type": "Person",
          name: `${author}`,
          ...(profile && { url: profile }),
        },
      ],
    }
  : null;

// 非文章页（首页 / 关于 / 标签页 等）输出 WebSite + Organization 结构化数据，
// 帮助 Google 建立品牌知识面板（Knowledge Panel）和站内搜索框（SiteLinks Search Box）。
const websiteSchema = !isPost
  ? {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: SITE.title,
      alternateName: "Findstay Accommodation Guide",
      url: SITE.website,
      inLanguage: SITE.lang,
      description: SITE.desc,
      potentialAction: {
        "@type": "SearchAction",
        target: {
          "@type": "EntryPoint",
          urlTemplate: `${SITE.website.replace(/\/$/, "")}/search?q={search_term_string}`,
        },
        "query-input": "required name=search_term_string",
      },
      publisher: {
        "@type": "Organization",
        name: SITE.author,
        url: SITE.website,
      },
    }
  : null;

const organizationSchema = !isPost
  ? {
      "@context": "https://schema.org",
      "@type": "Organization",
      name: SITE.author,
      alternateName: "出国留学网 StudyAbroad China",
      url: SITE.website,
      logo: new URL("/favicon.svg", SITE.website).toString(),
      description: SITE.desc,
      sameAs: [] as string[],
      knowsAbout: [
        "出国留学",
        "英国留学",
        "美国留学",
        "澳洲留学",
        "加拿大留学",
        "新西兰留学",
        "日本留学",
        "韩国留学",
        "香港留学",
        "新加坡留学",
        "马来西亚留学",
        "欧洲留学",
        "留学申请",
        "UCAS 申请",
        "Common App",
        "Student Visa",
        "F-1 签证",
        "Study Permit",
        "Subclass 500",
        "雅思 IELTS",
        "托福 TOEFL",
        "GRE",
        "GMAT",
        "留学奖学金",
        "毕业工签",
      ],
    }
  : null;
---

<!doctype html>
<html
  dir={SITE.dir}
  lang=`${SITE.lang ?? "en"}`
  class:list={{ "scroll-smooth": scrollSmooth }}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <!-- 图标：现代浏览器优先 SVG，不支持 SVG 的（360/QQ 浏览器旧版、IE、搜狗）回退到 ICO/PNG -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />


    <!-- General Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={metaKeywords} />
    <meta name="author" content={author} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph / Facebook -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />

    <!-- Article Published/Modified time -->
    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />

    <!-- JSON-LD Structured data（给搜索引擎） -->
    {
      blogPostingSchema && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(blogPostingSchema)}
        />
      )
    }
    {
      websiteSchema && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(websiteSchema)}
        />
      )
    }
    {
      organizationSchema && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(organizationSchema)}
        />
      )
    }

    <!-- Enable RSS feed auto-discovery  -->
    <!-- https://docs.astro.build/en/recipes/rss/#enabling-rss-feed-auto-discovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href={new URL("rss.xml", Astro.site)}
    />

    <meta name="theme-color" content="" />

    <!-- 搜索引擎站长验证标签（只有配置了环境变量才会输出） -->
    {
      PUBLIC_GOOGLE_SITE_VERIFICATION && (
        <meta
          name="google-site-verification"
          content={PUBLIC_GOOGLE_SITE_VERIFICATION}
        />
      )
    }
    {
      PUBLIC_BING_VERIFICATION && (
        <meta name="msvalidate.01" content={PUBLIC_BING_VERIFICATION} />
      )
    }
    {
      PUBLIC_BAIDU_VERIFICATION && (
        <meta
          name="baidu-site-verification"
          content={PUBLIC_BAIDU_VERIFICATION}
        />
      )
    }
    {
      PUBLIC_SOGOU_VERIFICATION && (
        <meta
          name="sogou_site_verification"
          content={PUBLIC_SOGOU_VERIFICATION}
        />
      )
    }
    {
      PUBLIC_360_VERIFICATION && (
        <meta name="360-site-verification" content={PUBLIC_360_VERIFICATION} />
      )
    }
    {
      PUBLIC_SHENMA_VERIFICATION && (
        <meta
          name="shenma-site-verification"
          content={PUBLIC_SHENMA_VERIFICATION}
        />
      )
    }
    {
      PUBLIC_TOUTIAO_VERIFICATION && (
        <meta
          name="bytedance-verification-code"
          content={PUBLIC_TOUTIAO_VERIFICATION}
        />
      )
    }

    <!-- Commission Factory traffic-source ownership verification. -->
    <meta
      name="commission-factory-verification"
      content="8cfd907be47f4b18924fff6ecc677e7f"
    />

    <ClientRouter />

    <!-- Minimal inline script to prevent FOUC - sets theme immediately -->
    <script is:inline>
      (function () {
        const initialColorScheme = ""; // "light" | "dark"
        const currentTheme = localStorage.getItem("theme");

        function getPreferTheme() {
          if (currentTheme) return currentTheme;
          if (initialColorScheme) return initialColorScheme;
          return window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
        }

        const themeValue = getPreferTheme();

        // Set theme immediately to prevent flash
        document.firstElementChild?.setAttribute("data-theme", themeValue);

        // Export minimal API for external script
        window.theme = {
          themeValue: themeValue,
          getTheme: () => window.theme.themeValue,
          setTheme: val => {
            window.theme.themeValue = val;
          },
        };
      })();
    </script>
  </head>
  <body>
    <slot />

    <!-- Load full theme logic -->
    <script src="../scripts/theme.ts"></script>

    <!-- FindStay · housing enquiry / Robin assistant / attribution -->
    <script
      src="https://chat.findstay.org/lead.js"
      data-site="findstay-org"
      data-lang="en"
      data-apply-base="https://apply.findstay.org"
      data-color="#0E5E56"
      data-accent="#F2664B"
      async></script>
    <script
      src="https://chat.findstay.org/assistant.js"
      data-site="findstay-org"
      data-lang="en"
      data-bot-name="Robin"
      data-channel="organic"
      data-color="#0E5E56"
      data-accent="#F2664B"
      data-no-bubble="1"
      async></script>
  </body>
</html>
