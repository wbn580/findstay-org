---
import { ClientRouter } from "astro:transitions";
import {
  PUBLIC_GOOGLE_SITE_VERIFICATION,
  PUBLIC_BING_VERIFICATION,
  PUBLIC_BAIDU_VERIFICATION,
  PUBLIC_SOGOU_VERIFICATION,
  PUBLIC_360_VERIFICATION,
  PUBLIC_SHENMA_VERIFICATION,
  PUBLIC_TOUTIAO_VERIFICATION,
} from "astro:env/client";
import { SITE } from "@/config";
import FsAiWizard from "@/components/fs/FsAiWizard.astro";
import countriesData from "@/data/countries.json";
import citiesData from "@/data/cities.json";
import statsData from "@/data/stats.json";
import "@/styles/global.css";

type Props = {
  title?: string;
  author?: string;
  profile?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  scrollSmooth?: boolean;
  tags?: string[];
  /** homepage & locale landings: transparent nav floating over the hero */
  transparentNav?: boolean;
  /** override html lang for locale landing pages */
  lang?: string;
};

const {
  title = SITE.title,
  author = SITE.author,
  profile = SITE.profile,
  description = SITE.desc,
  ogImage = SITE.ogImage ? `/${SITE.ogImage}` : "/og.png",
  canonicalURL = new URL(Astro.url.pathname, Astro.url),
  pubDatetime,
  modDatetime,
  scrollSmooth = false,
  tags,
  transparentNav = false,
  lang = SITE.lang,
} = Astro.props;

// 百度等中文搜索引擎仍会读取 meta keywords；Google 不再使用但也不会扣分。
// 文章页：用文章自身 tags；平台页：用站点主题词。
const metaKeywords =
  tags && tags.length > 0
    ? tags.join(", ")
    : "student housing, student accommodation, purpose built student accommodation, PBSA, student apartments, housing near university, student residence reviews, off campus housing, co-living, UniStay";

const socialImageURL = new URL(ogImage, Astro.url);
const isHome = Astro.url.pathname === "/";

const isPost = Boolean(pubDatetime);

const blogPostingSchema = isPost
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: `${title}`,
      image: `${socialImageURL}`,
      datePublished: pubDatetime!.toISOString(),
      ...(modDatetime && { dateModified: modDatetime.toISOString() }),
      author: [
        {
          "@type": "Person",
          name: `${author}`,
          ...(profile && { url: profile }),
        },
      ],
    }
  : null;

const websiteSchema = !isPost
  ? {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: SITE.title,
      alternateName: "UniStay Student Housing Search",
      url: SITE.website,
      inLanguage: SITE.lang,
      description: SITE.desc,
      potentialAction: {
        "@type": "SearchAction",
        target: {
          "@type": "EntryPoint",
          urlTemplate: `${SITE.website.replace(/\/$/, "")}/search?q={search_term_string}`,
        },
        "query-input": "required name=search_term_string",
      },
      publisher: {
        "@type": "Organization",
        name: SITE.author,
        url: SITE.website,
      },
    }
  : null;

const organizationSchema = !isPost
  ? {
      "@context": "https://schema.org",
      "@type": "Organization",
      name: "UniStay",
      alternateName: "UniStay Global Student Housing",
      url: SITE.website,
      logo: new URL("/favicon.svg", SITE.website).toString(),
      description: SITE.desc,
      sameAs: [] as string[],
      knowsAbout: [
        "student housing",
        "student accommodation",
        "purpose built student accommodation",
        "off campus housing",
        "co-living",
        "student residence reviews",
        "housing near university",
        "student rental costs",
        "QS ranked universities",
        "international student life",
      ],
    }
  : null;

// footer sitemap data (small JSON, baked at build)
const footCountries = (countriesData as { name: string; slug: string; property_count: number }[]).slice(0, 6);
const footCities = [...(citiesData as { name: string; slug: string; country: string; property_count: number }[])]
  .sort((a, b) => b.property_count - a.property_count)
  .slice(0, 8);
const footStats = statsData as { properties: number; cities: number; countries: number };
const year = new Date().getFullYear();
---

<!doctype html>
<html
  dir={SITE.dir}
  lang=`${lang ?? "en"}`
  class={`${scrollSmooth && "scroll-smooth"}`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <!-- favicon 五件套：SVG 优先，ICO 回退，PWA manifest -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- General Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={metaKeywords} />
    <meta name="author" content={author} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph / Facebook -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />

    <!-- Article Published/Modified time -->
    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />

    <!-- JSON-LD Structured data -->
    {
      blogPostingSchema && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(blogPostingSchema)}
        />
      )
    }
    {
      websiteSchema && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(websiteSchema)}
        />
      )
    }
    {
      organizationSchema && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(organizationSchema)}
        />
      )
    }

    <!-- per-page head extras (hreflang groups, page-level JSON-LD, …) -->
    <slot name="head" />

    <!-- Enable RSS feed auto-discovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href={new URL("rss.xml", Astro.site)}
    />

    <meta name="theme-color" content="#4B3FE4" />

    <!-- 搜索引擎站长验证标签（只有配置了环境变量才会输出） -->
    {
      PUBLIC_GOOGLE_SITE_VERIFICATION && (
        <meta
          name="google-site-verification"
          content={PUBLIC_GOOGLE_SITE_VERIFICATION}
        />
      )
    }
    {
      PUBLIC_BING_VERIFICATION && (
        <meta name="msvalidate.01" content={PUBLIC_BING_VERIFICATION} />
      )
    }
    {
      PUBLIC_BAIDU_VERIFICATION && (
        <meta
          name="baidu-site-verification"
          content={PUBLIC_BAIDU_VERIFICATION}
        />
      )
    }
    {
      PUBLIC_SOGOU_VERIFICATION && (
        <meta
          name="sogou_site_verification"
          content={PUBLIC_SOGOU_VERIFICATION}
        />
      )
    }
    {
      PUBLIC_360_VERIFICATION && (
        <meta name="360-site-verification" content={PUBLIC_360_VERIFICATION} />
      )
    }
    {
      PUBLIC_SHENMA_VERIFICATION && (
        <meta
          name="shenma-site-verification"
          content={PUBLIC_SHENMA_VERIFICATION}
        />
      )
    }
    {
      PUBLIC_TOUTIAO_VERIFICATION && (
        <meta
          name="bytedance-verification-code"
          content={PUBLIC_TOUTIAO_VERIFICATION}
        />
      )
    }

    <!-- Commission Factory affiliate site ownership verification (unistay.net) -->
    <meta
      name="commission-factory-verification"
      content="9a60115b693b488b9a36b993c99d02ba"
    />

    <ClientRouter />

    <!-- UniStay Design System -->
    <link rel="stylesheet" href="/g11.css?v=campus5" />

    <!-- Minimal inline script to prevent FOUC - sets theme immediately -->
    <script is:inline>
      (function () {
        const themeValue = "light";
        document.firstElementChild?.setAttribute("data-theme", themeValue);
        window.theme = {
          themeValue: themeValue,
          getTheme: () => window.theme.themeValue,
          setTheme: val => {
            window.theme.themeValue = val;
          },
        };
      })();
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>

    <!-- UniStay Nav -->
    <nav class={`nav${transparentNav ? " overlay" : ""}`} id="topNav" aria-label="Main navigation">
      <div class="nav-inner">
        <a href="/" class="brand" aria-label="UniStay home">
          <img src="/favicon.svg" alt="" width="30" height="30" />
          <span class="title">
            <b>Uni<em>Stay</em></b>
            <span>Student housing search</span>
          </span>
        </a>
        <div class="nav-links" id="navLinks">
          <a href="/housing/">Housing</a>
          <a href="/universities/">Universities</a>
          <a href="/posts/">Guides</a>
          <a href="/about/">About</a>
          <div class="nav-lang" id="navLang">
            <button type="button" class="nav-lang-btn" aria-label="Language" aria-haspopup="true" aria-expanded="false">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.7 2.5 15.3 0 18M12 3c-2.5 2.7-2.5 15.3 0 18"/></svg>
              <span>EN</span>
              <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="nav-lang-menu" role="menu">
              <a href="/" role="menuitem">English</a>
              <a href="https://unistay.cn/" role="menuitem">简体中文</a>
              <a href="/zh-hant/" role="menuitem">繁體中文</a>
              <a href="/es/" role="menuitem">Español</a>
              <a href="/id/" role="menuitem">Bahasa Indonesia</a>
              <a href="/ja/" role="menuitem">日本語</a>
              <a href="/ko/" role="menuitem">한국어</a>
              <a href="/pt/" role="menuitem">Português</a>
              <a href="/th/" role="menuitem">ไทย</a>
              <a href="/vi/" role="menuitem">Tiếng Việt</a>
            </div>
          </div>
          <button type="button" class="nav-cta" onclick="window.aiwOpen?.()">
            <span class="dot" aria-hidden="true"></span>Ask Robin
          </button>
        </div>
        <button type="button" class="hamb" id="hambBtn" aria-label="Open menu" aria-expanded="false" aria-controls="navLinks">
          <span></span><span></span><span></span>
        </button>
      </div>
    </nav>

    <slot />

    <script is:inline src="/_i/e0dc1f2f.js"></script>

    {!isHome && (
      <>
        <button type="button" class="fsw-fab" onclick="window.fsOpenWizard&&window.fsOpenWizard()" aria-label="Find my home with AI">
          <span class="fsw-fab-ai">AI</span><span>Find my home</span>
        </button>
        <div class="fsw-modal" id="fswModal" aria-hidden="true">
          <div class="fsw-modal-bg" onclick="window.fsCloseWizard&&window.fsCloseWizard()"></div>
          <div class="fsw-modal-card">
            <button type="button" class="fsw-modal-x" onclick="window.fsCloseWizard&&window.fsCloseWizard()" aria-label="Close">✕</button>
            <FsAiWizard />
          </div>
        </div>
      </>
    )}

    <!-- UniStay Footer -->
    <footer class="foot">
      <div class="foot-grid">
        <div class="foot-brand">
          <a href="/" class="logo">
            <img src="/favicon.svg" alt="" width="28" height="28" loading="lazy" />
            <b>Uni<em>Stay</em></b>
          </a>
          <p>
            A global student-housing search across {footStats.properties.toLocaleString("en-US")} residences
            in {footStats.cities} cities and {footStats.countries} countries — with real resident reviews
            and an AI assistant that helps you shortlist.
          </p>
          <p class="fine">
            Prices shown are indicative and change with availability — always confirm
            with the operator before signing. UniStay is an information service,
            not a landlord or letting agent.
          </p>
        </div>
        <div>
          <h4>Top countries</h4>
          {footCountries.map(c => <a href={`/housing/${c.slug}/`}>{c.name}</a>)}
          <a href="/housing/">All countries →</a>
        </div>
        <div>
          <h4>Top cities</h4>
          {footCities.map(c => <a href={`/housing/${c.country}/${c.slug}/`}>{c.name}</a>)}
        </div>
        <div>
          <h4>Explore</h4>
          <a href="/universities/">Universities</a>
          <a href="/posts/">Guides</a>
          <a href="/about/">About</a>
          <a href="/search/">Search</a>
          <a href="/privacy/">Privacy</a>
          <a href="/disclaimer/">Disclaimer</a>
          <a href="/rss.xml">RSS feed</a>
        </div>
      </div>
      <div class="foot-bottom">
        <div class="inner">
          <span>&copy; {year} UniStay · unistay.net</span>
          <span>Compare student housing near {footStats.cities} cities worldwide</span>
        </div>
      </div>
    </footer>

    <!-- 留资入口中心化组件（吸底两按钮 + 桌面药丸 + 文中图片卡） -->
    <script src="https://chat.unistay.cn/lead.js" data-site="findstay-org" data-lang="en" data-apply-base="https://apply.unistay.cn" async data-color="#4B3FE4" data-accent="#CDEB5A"></script>
    <!-- 唯一对话入口：CTA-only 品牌紫，提供 window.aiwOpen 给站内按钮与 lead.js -->
    <script src="https://chat.unistay.cn/assistant.js" data-site="findstay-org" data-lang="en" data-bot-name="Robin" data-channel="organic" data-no-bubble="1" data-color="#4B3FE4" data-accent="#3A2FC4" async></script>
    <script src="../scripts/theme.ts"></script>

    <!-- Nav + reveal behaviour (ClientRouter-safe: window listeners bound once,
         per-element listeners guarded via dataset) -->
    <script>
      function fsInitPage() {
        // hamburger — nav element is replaced on view transitions, so re-bind with guard
        const nav = document.getElementById("topNav");
        const hamb = document.getElementById("hambBtn");
        if (nav && hamb && !hamb.dataset.fsBound) {
          hamb.dataset.fsBound = "1";
          hamb.addEventListener("click", () => {
            const open = nav.classList.toggle("open");
            hamb.setAttribute("aria-expanded", open ? "true" : "false");
            hamb.setAttribute("aria-label", open ? "Close menu" : "Open menu");
          });
          // close menu when a link inside is clicked
          nav.querySelectorAll(".nav-links > a, .nav-lang-menu a, .nav-cta").forEach(el => {
            el.addEventListener("click", () => {
              nav.classList.remove("open");
              hamb.setAttribute("aria-expanded", "false");
            });
          });
        }
        fsOnScroll();

        // scroll reveal
        const targets = document.querySelectorAll(".fs-reveal:not(.fs-in)");
        if (targets.length) {
          if (
            !("IntersectionObserver" in window) ||
            window.matchMedia("(prefers-reduced-motion: reduce)").matches
          ) {
            targets.forEach(el => el.classList.add("fs-in"));
          } else {
            const io = new IntersectionObserver(
              entries => {
                entries.forEach(e => {
                  if (e.isIntersecting) {
                    e.target.classList.add("fs-in");
                    io.unobserve(e.target);
                  }
                });
              },
              { rootMargin: "0px 0px -8% 0px", threshold: 0.08 }
            );
            targets.forEach(el => io.observe(el));
          }
        }
      }

      function fsOnScroll() {
        const nav = document.getElementById("topNav");
        if (!nav) return;
        const threshold = nav.classList.contains("overlay")
          ? window.innerHeight * 0.55
          : 8;
        nav.classList.toggle("scrolled", window.scrollY > threshold);
      }

      // window-level listeners: bind exactly once
      if (!(window as any).__fsBound) {
        (window as any).__fsBound = true;
        window.addEventListener("scroll", fsOnScroll, { passive: true });
        document.addEventListener("astro:page-load", fsInitPage);
      }
      // initial load (astro:page-load also fires on first load, dataset guards make this idempotent)
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", fsInitPage, { once: true });
      } else {
        fsInitPage();
      }
    </script>
  </body>
</html>
