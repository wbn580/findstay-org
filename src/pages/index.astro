---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { getPath } from "@/utils/getPath";
import { slugifyTag } from "@/utils/tagSlug";

const posts = await getCollection("blog");
const sorted = getSortedPosts(posts);
const totalCount = posts.filter(p => !p.data.draft).length;

// Countries for the grid
const countries = [
  { flag: "🇦🇺", name: "Australia", slug: "australia", count: 0, color: "from-teal-600 to-teal-800" },
  { flag: "🇳🇿", name: "New Zealand", slug: "new-zealand", count: 0, color: "from-emerald-600 to-emerald-800" },
  { flag: "🇬🇧", name: "United Kingdom", slug: "uk", count: 0, color: "from-blue-700 to-blue-900" },
  { flag: "🇺🇸", name: "United States", slug: "us", count: 0, color: "from-indigo-600 to-indigo-800" },
  { flag: "🇨🇦", name: "Canada", slug: "canada", count: 0, color: "from-red-600 to-red-800" },
  { flag: "🇩🇪", name: "Germany", slug: "germany", count: 0, color: "from-amber-600 to-amber-800" },
  { flag: "🇫🇷", name: "France", slug: "france", count: 0, color: "from-rose-600 to-rose-800" },
  { flag: "🇸🇬", name: "Singapore", slug: "singapore", count: 0, color: "from-cyan-600 to-cyan-800" },
];

// Count per country
countries.forEach(c => {
  c.count = posts.filter(p => !p.data.draft && p.data.tags?.includes(c.slug)).length;
});

// Featured posts (first 6 non-draft)
const featured = sorted.slice(0, 6);
---

<Layout>
  <Header />

  <main id="main-content" data-layout="index" class="font-sans text-ink">
    <!-- ========== HERO ========== -->
    <section class="relative overflow-hidden bg-gradient-to-br from-teal-50 via-white to-amber-50 dark:from-gray-900 dark:via-gray-900 dark:to-gray-800">
      <div class="max-w-7xl mx-auto px-6 py-20 sm:py-28 lg:py-36">
        <div class="max-w-3xl">
          <span class="inline-flex items-center gap-2 bg-sun/20 text-ink dark:text-ink font-bold text-xs tracking-widest uppercase px-4 py-2 rounded-full border border-sun/30 mb-6">
            🌏 Global Accommodation Guide 2026
          </span>
          <h1 class="text-5xl sm:text-6xl lg:text-7xl font-black tracking-tight leading-[1.02] text-ink dark:text-ink mb-6">
            Find Your Home<br />
            <span class="text-accent">Away From Home</span>
          </h1>
          <p class="text-lg sm:text-xl text-ink-2 max-w-2xl leading-relaxed mb-8">
            Smart accommodation guides for international students, expats &amp; digital nomads.
            Compare student housing, long-stay rentals, and co-living spaces across <strong class="text-ink">15+ cities worldwide</strong>.
          </p>
          <div class="flex flex-wrap gap-4">
            <a href="/posts/" class="inline-flex items-center gap-2 bg-accent text-white font-bold px-6 py-3.5 rounded-xl shadow-lg hover:shadow-xl hover:-translate-y-0.5 transition-all text-base">
              Browse All Guides <span class="text-xl">→</span>
            </a>
            <a href="/about/" class="inline-flex items-center gap-2 border-2 border-ink/20 dark:border-ink/30 text-ink font-bold px-6 py-3.5 rounded-xl hover:border-accent hover:text-accent transition-all text-base">
              About Findstay
            </a>
          </div>
        </div>
      </div>
      <!-- Decorative blobs -->
      <div class="absolute -top-24 -right-24 w-96 h-96 bg-sun/10 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
      <div class="absolute -bottom-32 -left-32 w-80 h-80 bg-accent/10 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
    </section>

    <!-- ========== COUNTRY GRID ========== -->
    <section class="max-w-7xl mx-auto px-6 py-16 sm:py-24">
      <div class="text-center mb-12">
        <span class="text-xs tracking-[0.3em] uppercase text-accent font-bold">Destinations</span>
        <h2 class="text-3xl sm:text-4xl font-black tracking-tight mt-2 text-ink">Where are you headed?</h2>
        <p class="text-ink-2 mt-3 max-w-xl mx-auto">In-depth accommodation guides for students and professionals in 8 countries</p>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        {countries.map(c => (
          <a href={`/tags/${c.slug}/`} class="group relative overflow-hidden rounded-2xl border border-rule bg-card hover:shadow-xl hover:-translate-y-1 transition-all duration-200">
            <div class="p-5 sm:p-6">
              <span class="text-3xl sm:text-4xl block mb-3">{c.flag}</span>
              <h3 class="font-bold text-lg text-ink group-hover:text-accent transition-colors">{c.name}</h3>
              <p class="text-sm text-ink-3 mt-1">{c.count} guide{c.count !== 1 ? 's' : ''}</p>
              <span class="inline-flex items-center gap-1 text-accent font-bold text-sm mt-3 opacity-0 group-hover:opacity-100 transition-opacity">
                Explore <span>→</span>
              </span>
            </div>
            <div class={`absolute inset-0 bg-gradient-to-br opacity-0 group-hover:opacity-5 transition-opacity pointer-events-none ${c.color}`} aria-hidden="true"></div>
          </a>
        ))}
      </div>
    </section>

    <!-- ========== FEATURED POSTS ========== -->
    <section class="bg-muted py-16 sm:py-24">
      <div class="max-w-7xl mx-auto px-6">
        <div class="flex items-end justify-between mb-10">
          <div>
            <span class="text-xs tracking-[0.3em] uppercase text-accent font-bold">Latest Guides</span>
            <h2 class="text-3xl sm:text-4xl font-black tracking-tight mt-2 text-ink">Featured Articles</h2>
          </div>
          <a href="/posts/" class="hidden sm:inline-flex items-center gap-1 text-accent font-bold text-sm hover:underline">
            View all {totalCount} guides <span>→</span>
          </a>
        </div>
        {featured.length > 0 ? (
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {featured.map(p => (
              <a href={getPath(p.id, p.filePath)} class="group bg-card rounded-2xl border border-rule overflow-hidden hover:shadow-lg hover:-translate-y-1 transition-all duration-200 flex flex-col">
                {p.data.heroImage && (
                  <div class="h-48 overflow-hidden">
                    <img src={p.data.heroImage} alt={p.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                  </div>
                )}
                <div class="p-5 flex flex-col flex-1">
                  <div class="flex flex-wrap gap-2 mb-3">
                    {p.data.tags?.slice(0, 2).map((t: string) => (
                      <span class="text-xs font-bold text-accent bg-accent/10 px-2.5 py-1 rounded-full">{t}</span>
                    ))}
                  </div>
                  <h3 class="font-bold text-lg leading-snug text-ink group-hover:text-accent transition-colors mb-2">{p.data.title}</h3>
                  <p class="text-sm text-ink-2 leading-relaxed flex-1">{p.data.description}</p>
                  <div class="mt-4 text-xs text-ink-3 font-medium">
                    {new Date(p.data.pubDatetime).toLocaleDateString("en-AU", { day: "numeric", month: "short", year: "numeric" })}
                  </div>
                </div>
              </a>
            ))}
          </div>
        ) : (
          <div class="text-center py-16 bg-card rounded-2xl border border-rule">
            <p class="text-ink-2 text-lg">Articles coming soon. Check back shortly!</p>
          </div>
        )}
        <div class="text-center mt-8 sm:hidden">
          <a href="/posts/" class="inline-flex items-center gap-1 text-accent font-bold text-sm hover:underline">
            View all {totalCount} guides <span>→</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ========== AFFILIATE BOX ========== -->
    <section class="max-w-7xl mx-auto px-6 py-16 sm:py-24">
      <div class="bg-gradient-to-br from-accent to-maple-2 rounded-3xl p-8 sm:p-12 text-white relative overflow-hidden shadow-xl">
        <div class="relative z-10 max-w-2xl">
          <span class="text-xs tracking-[0.3em] uppercase text-sun font-bold mb-3 block">Protected & Insured</span>
          <h2 class="text-3xl sm:text-4xl font-black tracking-tight mb-4">Going abroad? Get covered.</h2>
          <p class="text-white/80 text-lg leading-relaxed mb-8">
            International students need Overseas Student Health Cover (OSHC) to meet visa requirements. Digital nomads &amp; expats need reliable travel insurance. Compare your options:
          </p>
          <div class="flex flex-wrap gap-4">
            <a
              href="https://agents.flywire.com/services/Unilink/oshc-au?referrer=0df195ef-7f4d-4faf-82e2-1878faa84597"
              target="_blank"
              rel="nofollow noopener noreferrer"
              class="inline-flex items-center gap-2 bg-white text-accent font-bold px-6 py-3.5 rounded-xl shadow-lg hover:shadow-xl hover:-translate-y-0.5 transition-all"
            >
              🏥 Compare OSHC <span>→</span>
            </a>
            <a
              href="https://safetywing.com/?affiliate_id=17632"
              target="_blank"
              rel="nofollow noopener noreferrer"
              class="inline-flex items-center gap-2 border-2 border-white/30 text-white font-bold px-6 py-3.5 rounded-xl hover:bg-white/10 transition-all"
            >
              🌍 SafetyWing Insurance <span>→</span>
            </a>
          </div>
        </div>
        <!-- Decorative -->
        <div class="absolute -right-12 -top-12 w-64 h-64 bg-white/10 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
        <div class="absolute -bottom-20 right-20 w-48 h-48 bg-sun/20 rounded-full blur-2xl pointer-events-none" aria-hidden="true"></div>
      </div>
    </section>

    <!-- ========== BOTTOM CTA ========== -->
    <section class="bg-muted py-16 sm:py-24">
      <div class="max-w-3xl mx-auto px-6 text-center">
        <span class="text-xs tracking-[0.3em] uppercase text-accent font-bold">Start Your Journey</span>
        <h2 class="text-3xl sm:text-4xl font-black tracking-tight mt-2 text-ink mb-4">Ready to find your stay?</h2>
        <p class="text-ink-2 text-lg mb-8 max-w-xl mx-auto">
          Browse our guides by country, learn about rental rights, compare accommodation types, and get insured — all in one place.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/posts/" class="inline-flex items-center gap-2 bg-accent text-white font-bold px-8 py-4 rounded-xl shadow-lg hover:shadow-xl hover:-translate-y-0.5 transition-all">
            Browse All Guides → 
          </a>
          <a href="/tags/" class="inline-flex items-center gap-2 border-2 border-ink/20 dark:border-ink/30 text-ink font-bold px-8 py-4 rounded-xl hover:border-accent hover:text-accent transition-all">
            Browse by Tag
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const el = document.querySelector("#main-content") as HTMLElement | null;
    if (el?.dataset?.layout === "index") {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
