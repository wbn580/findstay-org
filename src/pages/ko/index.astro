---
import LocaleLanding from "@/components/fs/LocaleLanding.astro";
import { stats, fmtInt } from "@/utils/fsData";

const t = {
  title: `UniStay — 글로벌 학생 주거 검색: ${stats.cities}개 도시 ${fmtInt(stats.properties)}개 레지던스 (2026)`,
  desc: `${stats.countries}개국 ${stats.cities}개 도시의 학생 레지던스 ${fmtInt(stats.properties)}곳을 비교하세요. 실제 거주자 리뷰, 참고 가격, QS 랭킹 ${fmtInt(stats.universities)}개 대학과의 매핑을 제공합니다.`,
  eyebrow: "글로벌 학생 주거 · 2026 입학 시즌",
  h1: "캠퍼스 가까이,",
  h1em: "나에게 맞는 집",
  lead: `<b>${fmtInt(stats.properties)}개 레지던스</b> · <b>${stats.cities}개 도시</b> · <b>${stats.countries}개국</b> — 홍보 브로슈어가 아닌 실제 거주자 리뷰와 참고 가격으로 비교합니다.`,
  askRobin: "Robin에게 묻기 — AI 주거 매칭",
  browse: "도시 둘러보기",
  stepsKicker: "이용 방법",
  stepsH2: "세 단계면 충분합니다",
  steps: [
    { h: "Robin에게 대학과 예산을 알려주세요", p: "채팅을 열고 대학, 예산, 입주 월을 알려주세요. Robin이 수천 개 레지던스 중 실제로 조건에 맞는 몇 곳만 추려 드립니다." },
    { h: "실제 가격과 리뷰를 비교하세요", p: "각 레지던스 페이지에는 참고 가격, 룸 타입, 공개된 거주자 리뷰 원문 발췌가 있습니다. 좋은 점과 아쉬운 점을 모두 확인할 수 있습니다." },
    { h: "어드바이저의 후속 상담을 받으세요", p: "후보 목록이 정해지면 주거 어드바이저가 영업일 1일 이내에 연락해 운영사와의 세부 확인을 도와드립니다. 계약과 결제는 항상 본인이 운영사와 직접 진행합니다." },
  ],
  countriesKicker: "유학 목적지",
  countriesH2: "국가별로 둘러보기",
  residencesWord: "개 레지던스",
  citiesWord: "개 도시",
  note: "도시 및 레지던스 상세 페이지는 현재 영어로 제공됩니다. 모든 가격은 참고용이며, 계약 전 반드시 운영사에 최신 요금을 확인하세요.",
  ctaH2: "3,000개의 탭 대신, 한 장의 후보 목록으로",
  ctaP: `Robin은 ${fmtInt(stats.properties)}개 레지던스와 ${fmtInt(stats.universities)}개 대학 데이터를 교차 검증합니다. 데이터 너머의 일은 사람 어드바이저가 이어받습니다.`,
  statResidences: "레지던스",
  statCities: "도시",
  statCountries: "개국",
  statUnis: "QS 대학",
};

const countryNames = {
  "united-states": "미국",
  "united-kingdom": "영국",
  spain: "스페인",
  australia: "호주",
  canada: "캐나다",
  germany: "독일",
  singapore: "싱가포르",
  france: "프랑스",
  ireland: "아일랜드",
  "new-zealand": "뉴질랜드",
  uae: "아랍에미리트",
  italy: "이탈리아",
};
---

<LocaleLanding locale="ko" htmlLang="ko" t={t} countryNames={countryNames} />
