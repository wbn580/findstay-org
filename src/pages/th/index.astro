---
import LocaleLanding from "@/components/fs/LocaleLanding.astro";
import { stats, fmtInt } from "@/utils/fsData";

const t = {
  title: `UniStay — ค้นหาที่พักนักศึกษาทั่วโลก: ${fmtInt(stats.properties)} แห่งใน ${stats.cities} เมือง (2026)`,
  desc: `เปรียบเทียบหอพักนักศึกษา ${fmtInt(stats.properties)} แห่งใน ${stats.cities} เมือง ${stats.countries} ประเทศ: รีวิวจริงจากผู้เข้าพัก ราคาอ้างอิง และจับคู่กับมหาวิทยาลัย QS ${fmtInt(stats.universities)} แห่ง`,
  eyebrow: "ที่พักนักศึกษาทั่วโลก · ปีการศึกษา 2026",
  h1: "หาที่พักของคุณ",
  h1em: "ใกล้มหาวิทยาลัย",
  lead: `<b>${fmtInt(stats.properties)} ที่พัก</b> · <b>${stats.cities} เมือง</b> · <b>${stats.countries} ประเทศ</b> — เปรียบเทียบด้วยรีวิวจริงจากผู้เข้าพักและราคาอ้างอิง ไม่ใช่โบรชัวร์โฆษณา`,
  askRobin: "ถาม Robin — ผู้ช่วย AI",
  browse: "ดูตามเมือง",
  stepsKicker: "ใช้งานอย่างไร",
  stepsH2: "สามขั้นตอน ไม่ต้องเดา",
  steps: [
    { h: "บอก Robin ว่าเรียนที่ไหน งบเท่าไร", p: "เปิดแชทแล้วบอกมหาวิทยาลัย งบประมาณ และเดือนที่จะเข้าพัก Robin จะกรองที่พักหลายพันแห่งให้เหลือเฉพาะที่เหมาะกับคุณจริง ๆ" },
    { h: "เปรียบเทียบราคาและรีวิวจริง", p: "หน้าที่พักแต่ละแห่งแสดงราคาอ้างอิง ประเภทห้อง และรีวิวจากผู้เข้าพักจริงแบบคำต่อคำ — ทั้งด้านดีและด้านเสีย" },
    { h: "มีที่ปรึกษาติดตามต่อให้", p: "เมื่อได้รายชื่อที่ถูกใจ ที่ปรึกษาด้านที่พักจะติดต่อกลับภายในหนึ่งวันทำการ ช่วยยืนยันรายละเอียดกับผู้ให้บริการ สัญญาและการชำระเงินคุณจัดการกับผู้ให้บริการโดยตรง" },
  ],
  countriesKicker: "จุดหมายปลายทาง",
  countriesH2: "เลือกดูตามประเทศ",
  residencesWord: "ที่พัก",
  citiesWord: "เมือง",
  note: "หน้าเมืองและหน้าที่พักให้บริการเป็นภาษาอังกฤษ ราคาทั้งหมดเป็นราคาอ้างอิง — โปรดยืนยันราคาปัจจุบันกับผู้ให้บริการก่อนทำสัญญา",
  ctaH2: "เริ่มจากลิสต์สั้น ๆ ไม่ใช่แท็บสามพันแท็บ",
  ctaP: `Robin ประมวลข้อมูลที่พัก ${fmtInt(stats.properties)} แห่งและมหาวิทยาลัย ${fmtInt(stats.universities)} แห่ง — จุดที่ข้อมูลไปไม่ถึง ที่ปรึกษาตัวจริงรับช่วงต่อ`,
  statResidences: "ที่พัก",
  statCities: "เมือง",
  statCountries: "ประเทศ",
  statUnis: "มหาวิทยาลัย QS",
};

const countryNames = {
  "united-states": "สหรัฐอเมริกา",
  "united-kingdom": "สหราชอาณาจักร",
  spain: "สเปน",
  australia: "ออสเตรเลีย",
  canada: "แคนาดา",
  germany: "เยอรมนี",
  singapore: "สิงคโปร์",
  france: "ฝรั่งเศส",
  ireland: "ไอร์แลนด์",
  "new-zealand": "นิวซีแลนด์",
  uae: "สหรัฐอาหรับเอมิเรตส์",
  italy: "อิตาลี",
};
---

<LocaleLanding locale="th" htmlLang="th" t={t} countryNames={countryNames} />
